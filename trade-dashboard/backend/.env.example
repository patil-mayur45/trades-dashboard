# --- Mock BSE API ---
# Total time one full pull takes. 900 = 15 minutes (the assessment scenario).
BSE_DELAY_SECONDS=30
# Seed size of the mock exchange (2,000 - 5,000 recommended)
BSE_TOTAL_TRADES=5000
# The mock exchange keeps "trading": new trades appear over time so every pull finds fresh data
BSE_GROWTH_PER_MINUTE=20
# Leave empty to call the mock API on this same server. Set it to point at a different BSE host.
BSE_API_URL=
